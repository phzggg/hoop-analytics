/// Jogadores identificados pela ESPN nos jogos coletados.
table Jogadores
	lineageTag: 26ceacc3-69b2-4c81-9617-63bf57872782

	column 'Jogador Id'
		dataType: string
		isHidden
		lineageTag: e241717e-ee91-4763-bd71-22dfed46ff31
		summarizeBy: none
		sourceColumn: player_id

	/// Nome do jogador publicado pela ESPN.
	column Jogador
		dataType: string
		lineageTag: 525b45e5-58ab-4384-92f0-30078358883f
		summarizeBy: none
		sourceColumn: player_name

	/// Última posição observada nos jogos coletados.
	column Posição
		dataType: string
		summarizeBy: none
		sourceColumn: position

	/// Última foto observada nos jogos coletados.
	column Foto
		dataType: string
		dataCategory: ImageUrl
		summarizeBy: none
		sourceColumn: headshot_url

	partition Jogadores = entity
		mode: directLake
		source
			entityName: gold_espn_players
			expressionSource: 'DirectLake NBA'

