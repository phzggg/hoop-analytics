/// Uma linha por partida, incluindo jogos agendados e finalizados.
table Partidas

	/// Identificador ESPN da partida.
	column 'Jogo Id'
		dataType: string
		summarizeBy: none
		sourceColumn: game_id

	/// Data da partida.
	column Data
		dataType: dateTime
		summarizeBy: none
		sourceColumn: game_date

	/// Temporada informada pela ESPN.
	column Temporada
		dataType: string
		summarizeBy: none
		sourceColumn: season_name

	/// Fase da temporada informada pela ESPN.
	column Fase
		dataType: string
		summarizeBy: none
		sourceColumn: season_type

	/// Identificador ESPN do time mandante.
	column 'Mandante Id'
		dataType: string
		summarizeBy: none
		sourceColumn: home_team_id

	/// Time mandante.
	column Mandante
		dataType: string
		summarizeBy: none
		sourceColumn: home_team

	/// Sigla do time mandante.
	column 'Sigla mandante'
		dataType: string
		summarizeBy: none
		sourceColumn: home_team_abbreviation

	/// Endereço da imagem do time mandante.
	column 'Logo mandante'
		dataType: string
		dataCategory: ImageUrl
		summarizeBy: none
		sourceColumn: home_team_logo

	/// Identificador ESPN do time visitante.
	column 'Visitante Id'
		dataType: string
		summarizeBy: none
		sourceColumn: away_team_id

	/// Time visitante.
	column Visitante
		dataType: string
		summarizeBy: none
		sourceColumn: away_team

	/// Sigla do time visitante.
	column 'Sigla visitante'
		dataType: string
		summarizeBy: none
		sourceColumn: away_team_abbreviation

	/// Endereço da imagem do time visitante.
	column 'Logo visitante'
		dataType: string
		dataCategory: ImageUrl
		summarizeBy: none
		sourceColumn: away_team_logo

	/// Placar do mandante; vazio quando indisponível.
	column 'Pontos mandante'
		dataType: int64
		summarizeBy: none
		sourceColumn: home_score

	/// Placar do visitante; vazio quando indisponível.
	column 'Pontos visitante'
		dataType: int64
		summarizeBy: none
		sourceColumn: away_score

	/// Situação da partida publicada pela ESPN.
	column Situação
		dataType: string
		summarizeBy: none
		sourceColumn: status

	partition Partidas = entity
		mode: directLake
		source
			entityName: gold_espn_games
			expressionSource: 'DirectLake NBA'

