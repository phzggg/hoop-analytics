relationship 'Jogadores por Id'
	fromColumn: Participations.'Jogador Id'
	toColumn: Jogadores.'Jogador Id'

relationship 'Partidas por Data'
	fromColumn: Partidas.Data
	toColumn: Calendar.Data

relationship 'Participações por Partida'
	fromColumn: Participations.'Jogo Id'
	toColumn: Partidas.'Jogo Id'

relationship 'Times por Partida'
	fromColumn: Team_Statistics.'Jogo Id'
	toColumn: Partidas.'Jogo Id'

relationship 'Períodos por Partida'
	fromColumn: Periods.'Jogo Id'
	toColumn: Partidas.'Jogo Id'

