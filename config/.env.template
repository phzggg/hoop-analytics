# Environment Configuration Template
# Copy this to .env and configure for your environment

# ========================================
# Fabric Configuration
# ========================================
FABRIC_WORKSPACE_NAME=YOUR_WORKSPACE
FABRIC_LAKEHOUSE_NAME=YOUR_LAKEHOUSE
FABRIC_TENANT_NAME=YOUR_TENANT

# ========================================
# NBA API Configuration
# ========================================
# Enable/disable NBA API calls
NBA_API_ENABLE=true

# Connection settings
NBA_API_BASE_URL=https://stats.nba.com/stats/
NBA_API_TIMEOUT=30
NBA_API_RETRIES=3
NBA_API_BACKOFF_FACTOR=1.5
NBA_API_RATE_LIMIT_DELAY=0.5  # Seconds between requests

# ========================================
# Application Settings
# ========================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
DEBUG_MODE=false

# Data settings
DATA_SAMPLE_FOLDER=data/sample
LOGS_FOLDER=logs

# ========================================
# Processing Settings
# ========================================
# Default date for ingestion (YYYY-MM-DD format)
# Leave empty to use current date
DEFAULT_INGESTION_DATE=

# Maximum number of games to process in a single run
MAX_GAMES_PER_RUN=15

# Enable data quality checks
ENABLE_DATA_QUALITY_CHECKS=true

# ========================================
# Development Settings
# ========================================
# Save API responses to disk for testing
SAVE_API_RESPONSES=true
API_RESPONSE_CACHE_FOLDER=data/sample

# Dry run mode (don't write to Lakehouse)
DRY_RUN=false
