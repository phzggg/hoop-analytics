/// NBA player analysis by game, with public ESPN data.
model 'NBA Player Analysis'
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: pt-BR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_ProTooling = ["MCP-PBIModeling"]

annotation __PBI_ServiceStoredInTmdl = reserved

annotation __LastRPTime = 134392832817649446

ref table Players
ref table 'Player Games'
ref table Calendar
ref table Games
ref table 'Team Statistics'
ref table Periods

