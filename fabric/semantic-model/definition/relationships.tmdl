relationship 'Players by Id'
	fromColumn: 'Player Games'.'Player Id'
	toColumn: Players.'Player Id'

relationship 'Games by Date'
	fromColumn: Games.Date
	toColumn: Calendar.Date

relationship 'Player Games by Game'
	fromColumn: 'Player Games'.'Game Id'
	toColumn: Games.'Game Id'

relationship 'Teams by Game'
	fromColumn: 'Team Statistics'.'Game Id'
	toColumn: Games.'Game Id'

relationship 'Periods by Game'
	fromColumn: Periods.'Game Id'
	toColumn: Games.'Game Id'

