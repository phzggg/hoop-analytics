/// One row per match, including scheduled and finished games.
table Partidas

	/// ESPN match identifier.
	column 'Jogo Id'
		dataType: string
		summarizeBy: none
		sourceColumn: game_id

	/// Match date.
	column Data
		dataType: dateTime
		summarizeBy: none
		sourceColumn: game_date

	/// Season provided by ESPN.
	column Temporada
		dataType: string
		summarizeBy: none
		sourceColumn: season_name

	/// Season phase provided by ESPN.
	column Fase
		dataType: string
		summarizeBy: none
		sourceColumn: season_type

	/// ESPN home team identifier.
	column 'Mandante Id'
		dataType: string
		summarizeBy: none
		sourceColumn: home_team_id

	/// Home team.
	column Mandante
		dataType: string
		summarizeBy: none
		sourceColumn: home_team

	/// Home team abbreviation.
	column 'Sigla mandante'
		dataType: string
		summarizeBy: none
		sourceColumn: home_team_abbreviation

	/// Home team logo URL.
	column 'Logo mandante'
		dataType: string
		dataCategory: ImageUrl
		summarizeBy: none
		sourceColumn: home_team_logo

	/// ESPN away team identifier.
	column 'Visitante Id'
		dataType: string
		summarizeBy: none
		sourceColumn: away_team_id

	/// Away team.
	column Visitante
		dataType: string
		summarizeBy: none
		sourceColumn: away_team

	/// Away team abbreviation.
	column 'Sigla visitante'
		dataType: string
		summarizeBy: none
		sourceColumn: away_team_abbreviation

	/// Away team logo URL.
	column 'Logo visitante'
		dataType: string
		dataCategory: ImageUrl
		summarizeBy: none
		sourceColumn: away_team_logo

	/// Home team score; empty when unavailable.
	column 'Pontos mandante'
		dataType: int64
		summarizeBy: none
		sourceColumn: home_score

	/// Away team score; empty when unavailable.
	column 'Pontos visitante'
		dataType: int64
		summarizeBy: none
		sourceColumn: away_score

	/// Match status published by ESPN.
	column Situação
		dataType: string
		summarizeBy: none
		sourceColumn: status

	partition Partidas = entity
		mode: directLake
		source
			entityName: gold_espn_games
			expressionSource: 'DirectLake NBA'

