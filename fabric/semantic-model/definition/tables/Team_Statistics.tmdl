/// One row per team and finished game with collected box score.
table 'Estatísticas de Times'

	/// ESPN match identifier.
	column 'Jogo Id'
		dataType: string
		summarizeBy: none
		sourceColumn: game_id

	/// ESPN team identifier.
	column 'Time Id'
		dataType: string
		summarizeBy: none
		sourceColumn: team_id

	/// Team in the match box score.
	column Time
		dataType: string
		summarizeBy: none
		sourceColumn: team_name

	/// Team abbreviation.
	column Sigla
		dataType: string
		summarizeBy: none
		sourceColumn: team_abbreviation

	/// Team logo URL.
	column Logo
		dataType: string
		dataCategory: ImageUrl
		summarizeBy: none
		sourceColumn: team_logo

	/// Indicates if the team played home or away.
	column 'Casa ou fora'
		dataType: string
		summarizeBy: none
		sourceColumn: home_away

	/// Points scored by team in the match.
	column 'Pontos feitos'
		dataType: int64
		summarizeBy: none
		sourceColumn: points_for

	/// Opponent points in the match.
	column 'Pontos sofridos'
		dataType: int64
		summarizeBy: none
		sourceColumn: points_against

	/// Team result in the match.
	column Resultado
		dataType: string
		summarizeBy: none
		sourceColumn: result

	/// Field goals made.
	column 'Arremessos convertidos'
		dataType: int64
		summarizeBy: none
		sourceColumn: field_goals_made

	/// Field goals attempted.
	column 'Arremessos tentados'
		dataType: int64
		summarizeBy: none
		sourceColumn: field_goals_attempted

	/// Three-point field goals made.
	column 'Bolas de três convertidas'
		dataType: int64
		summarizeBy: none
		sourceColumn: three_point_field_goals_made

	/// Three-point field goals attempted.
	column 'Bolas de três tentadas'
		dataType: int64
		summarizeBy: none
		sourceColumn: three_point_field_goals_attempted

	/// Free throws made.
	column 'Lances livres convertidos'
		dataType: int64
		summarizeBy: none
		sourceColumn: free_throws_made

	/// Free throws attempted.
	column 'Lances livres tentados'
		dataType: int64
		summarizeBy: none
		sourceColumn: free_throws_attempted

	/// Team rebounds.
	column Rebotes
		dataType: int64
		summarizeBy: none
		sourceColumn: rebounds

	/// Team assists.
	column Assistências
		dataType: int64
		summarizeBy: none
		sourceColumn: assists

	/// Team steals.
	column Roubos
		dataType: int64
		summarizeBy: none
		sourceColumn: steals

	/// Team blocks.
	column Tocos
		dataType: int64
		summarizeBy: none
		sourceColumn: blocks

	/// Team turnovers.
	column 'Perdas de bola'
		dataType: int64
		summarizeBy: none
		sourceColumn: turnovers

	/// Points scored in the paint.
	column 'Pontos no garrafão'
		dataType: int64
		summarizeBy: none
		sourceColumn: points_in_paint

	/// Fast break points.
	column 'Pontos em contra-ataque'
		dataType: int64
		summarizeBy: none
		sourceColumn: fast_break_points

	partition 'Estatísticas de Times' = entity
		mode: directLake
		source
			entityName: gold_espn_team_boxscores
			expressionSource: 'DirectLake NBA'

