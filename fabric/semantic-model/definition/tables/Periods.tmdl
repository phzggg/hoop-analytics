/// Points by team and period in finished matches.
table Periods

	/// ESPN game identifier.
	column 'Game Id'
		dataType: string
		summarizeBy: none
		sourceColumn: game_id

	/// ESPN team identifier.
	column 'Team Id'
		dataType: string
		summarizeBy: none
		sourceColumn: team_id

	/// Team that scored the points.
	column Team
		dataType: string
		summarizeBy: none
		sourceColumn: team_name

	/// Period number, including overtimes.
	column Period
		dataType: int64
		summarizeBy: none
		sourceColumn: period_number

	/// Period description published by the source.
	column 'Period Description'
		dataType: string
		summarizeBy: none
		sourceColumn: period_label

	/// Team points in the period.
	column 'Period Points'
		dataType: int64
		summarizeBy: none
		sourceColumn: points

	partition Periods = entity
		mode: directLake
		source
			entityName: gold_espn_game_periods
			expressionSource: 'DirectLake NBA'

