/// One row per team and finished game with collected box score.
table 'Team Statistics'

	/// ESPN match identifier.
	column 'Game Id'
		dataType: string
		summarizeBy: none
		sourceColumn: game_id

	/// ESPN team identifier.
	column 'Team Id'
		dataType: string
		summarizeBy: none
		sourceColumn: team_id

	/// Team in the match box score.
	column Team
		dataType: string
		summarizeBy: none
		sourceColumn: team_name

	/// Team abbreviation.
	column 'Team Abbreviation'
		dataType: string
		summarizeBy: none
		sourceColumn: team_abbreviation

	/// Team logo URL.
	column 'Team Logo'
		dataType: string
		dataCategory: ImageUrl
		summarizeBy: none
		sourceColumn: team_logo

	/// Indicates if the team played home or away.
	column 'Home or Away'
		dataType: string
		summarizeBy: none
		sourceColumn: home_away

	/// Points scored by team in the match.
	column 'Points For'
		dataType: int64
		summarizeBy: none
		sourceColumn: points_for

	/// Opponent points in the match.
	column 'Points Against'
		dataType: int64
		summarizeBy: none
		sourceColumn: points_against

	/// Team result in the match.
	column Result
		dataType: string
		summarizeBy: none
		sourceColumn: result

	/// Field goals made.
	column 'Field Goals Made'
		dataType: int64
		summarizeBy: none
		sourceColumn: field_goals_made

	/// Field goals attempted.
	column 'Field Goals Attempted'
		dataType: int64
		summarizeBy: none
		sourceColumn: field_goals_attempted

	/// Three-point field goals made.
	column 'Three Pointers Made'
		dataType: int64
		summarizeBy: none
		sourceColumn: three_point_field_goals_made

	/// Three-point field goals attempted.
	column 'Three Pointers Attempted'
		dataType: int64
		summarizeBy: none
		sourceColumn: three_point_field_goals_attempted

	/// Free throws made.
	column 'Free Throws Made'
		dataType: int64
		summarizeBy: none
		sourceColumn: free_throws_made

	/// Free throws attempted.
	column 'Free Throws Attempted'
		dataType: int64
		summarizeBy: none
		sourceColumn: free_throws_attempted

	/// Team rebounds.
	column Rebounds
		dataType: int64
		summarizeBy: none
		sourceColumn: rebounds

	/// Team assists.
	column Assists
		dataType: int64
		summarizeBy: none
		sourceColumn: assists

	/// Team steals.
	column Steals
		dataType: int64
		summarizeBy: none
		sourceColumn: steals

	/// Team blocks.
	column Blocks
		dataType: int64
		summarizeBy: none
		sourceColumn: blocks

	/// Team turnovers.
	column Turnovers
		dataType: int64
		summarizeBy: none
		sourceColumn: turnovers

	/// Points scored in the paint.
	column 'Points in the Paint'
		dataType: int64
		summarizeBy: none
		sourceColumn: points_in_paint

	/// Fast break points.
	column 'Fast Break Points'
		dataType: int64
		summarizeBy: none
		sourceColumn: fast_break_points

	partition 'Team Statistics' = entity
		mode: directLake
		source
			entityName: gold_espn_team_boxscores
			expressionSource: 'DirectLake NBA'

